{
  "info": {
    "name": "Admin Account Management API",
    "description": "Collection để test API quản lý tài khoản cho ADMIN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (Get JWT Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Lưu token vào biến collection",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "    console.log('Token saved:', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Đăng nhập với tài khoản admin để lấy JWT token"
      },
      "response": []
    },
    {
      "name": "2. Get All Accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts"]
        },
        "description": "Lấy danh sách tất cả tài khoản chưa bị xóa mềm"
      },
      "response": []
    },
    {
      "name": "3. Search Accounts - By Username",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/search?search=trainer",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "search"],
          "query": [
            {
              "key": "search",
              "value": "trainer"
            }
          ]
        },
        "description": "Tìm kiếm tài khoản theo username hoặc email"
      },
      "response": []
    },
    {
      "name": "4. Filter Accounts - By Role",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/search?role=TRAINER",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "search"],
          "query": [
            {
              "key": "role",
              "value": "TRAINER"
            }
          ]
        },
        "description": "Lọc tài khoản theo role (TRAINER hoặc MEMBER)"
      },
      "response": []
    },
    {
      "name": "5. Filter Accounts - By Active Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/search?isActive=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "search"],
          "query": [
            {
              "key": "isActive",
              "value": "true"
            }
          ]
        },
        "description": "Lọc tài khoản theo trạng thái active"
      },
      "response": []
    },
    {
      "name": "6. Search and Filter Combined",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/search?search=trainer&role=TRAINER&isActive=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "search"],
          "query": [
            {
              "key": "search",
              "value": "trainer"
            },
            {
              "key": "role",
              "value": "TRAINER"
            },
            {
              "key": "isActive",
              "value": "true"
            }
          ]
        },
        "description": "Tìm kiếm và lọc kết hợp"
      },
      "response": []
    },
    {
      "name": "7. Get Account By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "2"]
        },
        "description": "Xem chi tiết một tài khoản theo ID"
      },
      "response": []
    },
    {
      "name": "8. Create Account - Trainer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"newtrainer\",\n  \"password\": \"password123\",\n  \"role\": \"TRAINER\",\n  \"email\": \"newtrainer@gym.com\",\n  \"fullName\": \"New Trainer Test\",\n  \"phone\": \"0912345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts"]
        },
        "description": "Tạo tài khoản TRAINER mới"
      },
      "response": []
    },
    {
      "name": "9. Create Account - Member",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"newmember\",\n  \"password\": \"password123\",\n  \"role\": \"MEMBER\",\n  \"email\": \"newmember@gmail.com\",\n  \"fullName\": \"New Member Test\",\n  \"phone\": \"0987654321\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts"]
        },
        "description": "Tạo tài khoản MEMBER mới"
      },
      "response": []
    },
    {
      "name": "10. Update Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Updated Full Name\",\n  \"email\": \"updated@gym.com\",\n  \"phone\": \"0999999999\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "2"]
        },
        "description": "Cập nhật thông tin tài khoản (thay ID=2 bằng ID thực tế)"
      },
      "response": []
    },
    {
      "name": "11. Activate Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/3/activate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "3", "activate"]
        },
        "description": "Kích hoạt tài khoản (set isActive = true)"
      },
      "response": []
    },
    {
      "name": "12. Deactivate Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/3/deactivate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "3", "deactivate"]
        },
        "description": "Vô hiệu hóa tài khoản (set isActive = false)"
      },
      "response": []
    },
    {
      "name": "13. Soft Delete Account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts/8",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts", "8"]
        },
        "description": "Xóa mềm tài khoản (set deleted_at và isActive = false)"
      },
      "response": []
    },
    {
      "name": "14. Test - Try Create Admin (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"badactor\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\",\n  \"email\": \"badactor@test.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts"]
        },
        "description": "Test negative: Thử tạo tài khoản ADMIN (phải thất bại)"
      },
      "response": []
    },
    {
      "name": "15. Test - Try Duplicate Username (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"trainer01\",\n  \"password\": \"password123\",\n  \"role\": \"TRAINER\",\n  \"email\": \"duplicate@test.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "accounts"]
        },
        "description": "Test negative: Thử tạo tài khoản với username trùng (phải thất bại)"
      },
      "response": []
    }
  ]
}
